# Secretos: NUNCA al repo (si se filtra uno, revocarlo: queda en el historial)
.env
.env.*
!.env.example
*.pem
*.key
*-key.json
*credentials*.json
keys/
secrets/
!TP3/k8s/**/secret.example.yaml

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
.terraform.lock.hcl.bak

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Resultados locales
logs/
*.log
# ...salvo los logs de evidencia: son entregables del Hit #4 y de R5.
!TP3/evidencia/**/*.log
TP3/loadtest/results/
# ...pero los summary SI van: son las tablas que cita el informe (R5 sin sufijo,
# Hit #3 con sufijo _hit3). Sin estas excepciones la tabla del Hit #3 nunca
# llega al repo y el informe cita un archivo que no existe.
!TP3/loadtest/results/
TP3/loadtest/results/*
!TP3/loadtest/results/summary.md
!TP3/loadtest/results/summary.csv
!TP3/loadtest/results/summary_hit3.md
!TP3/loadtest/results/summary_hit3.csv
TP3/loadtest/images/

