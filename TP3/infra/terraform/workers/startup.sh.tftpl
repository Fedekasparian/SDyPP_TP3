#!/bin/bash
# Bootstrap del worker (equivalente a user_data). NO contiene secretos: los lee
# de Secret Manager con la identidad de la VM.
set -euxo pipefail

# 1) Bootstrap: herramientas
if ! command -v docker >/dev/null; then
  apt-get update
  apt-get install -y docker.io
  systemctl enable --now docker
fi

# 2) Deploy: auth al registry privado con el SA de la VM (sin claves) y pull
gcloud auth configure-docker ${region}-docker.pkg.dev --quiet
docker pull ${worker_image}

%{ if tailscale_secret != "" ~}
# Hit #2 (hibrido): la RabbitMQ/Redis estan en un equipo local, alcanzable por la
# red overlay de Tailscale (100.x). Solo trafico saliente: no se abre nada en GCP
# ni en el router de la casa. set +x para no imprimir la key en la consola serie.
if ! command -v tailscale >/dev/null; then curl -fsSL https://tailscale.com/install.sh | sh; fi
set +x
TS_KEY=$(gcloud secrets versions access latest --secret=${tailscale_secret})
tailscale up --authkey="$TS_KEY" --hostname="$(hostname)"
unset TS_KEY
set -x
for i in $(seq 1 30); do tailscale ping -c 1 ${rabbit_host} && break; sleep 5; done
%{ endif ~}

set +x   # las passwords no van a la consola serie
RABBIT_PASS=$(gcloud secrets versions access latest --secret=${rabbit_secret})
REDIS_PASS=$(gcloud secrets versions access latest --secret=${redis_secret})
# base64 puede traer /, + o =, que rompen las URLs: se codifican
RABBIT_ENC=$(python3 -c 'import sys,urllib.parse as u;print(u.quote(sys.argv[1],safe=""))' "$RABBIT_PASS")
REDIS_ENC=$(python3 -c 'import sys,urllib.parse as u;print(u.quote(sys.argv[1],safe=""))' "$REDIS_PASS")

# Imagenes: en el Hit #3 van al bucket de GCS (la VM autentica con su SA); en el hibrido
# al emulador fake-gcs-server del equipo local, por Tailscale. En Redis solo hay punteros.
%{ if tailscale_secret != "" ~}
BLOB_ENV="-e BLOB_BACKEND=gcs -e BLOB_BUCKET=tp3-images -e STORAGE_EMULATOR_HOST=http://${rabbit_host}:4443"
%{ else ~}
BLOB_ENV="-e BLOB_BACKEND=gcs -e BLOB_BUCKET=${blob_bucket}"
%{ endif ~}

# 3) Join: el worker se conecta a RabbitMQ/Redis (con retry + backoff) y empieza a consumir
docker rm -f tp3-worker || true
docker run -d --name tp3-worker --restart unless-stopped -p 8080:8080 \
  -e RABBIT_URL="amqp://tp3:$${RABBIT_ENC}@${rabbit_host}:5672/" \
  -e REDIS_URL="redis://:$${REDIS_ENC}@${redis_host}:6379/0" \
  $BLOB_ENV \
  -e WORKER_POOL=${worker_pool} \
  -e ALLOWED_WORKER_IMAGES=${worker_pool} \
  -e WORKER_ID="$(hostname)" \
  ${worker_image}
set -x
