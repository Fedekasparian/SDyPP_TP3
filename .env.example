# Copiar a .env (que esta en .gitignore) y completar. NO commitear valores reales.
RABBIT_USER=tp3
RABBIT_PASS=change-me
RABBIT_URL=amqp://tp3:change-me@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

# Imagenes en un bucket (en Redis solo el puntero). En compose: emulador fake-gcs-server.
BLOB_BACKEND=gcs
BLOB_BUCKET=tp3-images
STORAGE_EMULATOR_HOST=http://gcs:4443

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=change-me

ALLOWED_OPS=sobel,grayscale,blur,threshold
ALLOWED_WORKER_IMAGES=tp3-worker
ALLOWED_FORMATS=PNG,JPEG,BMP
MAX_FILE_MB=100
MAX_FILES=50
MAX_OPS=5
RATE_LIMIT_PER_MIN=600
FRAGMENTS_PER_IMAGE=4
MAX_RETRIES=3
FAIL_RATE=0
